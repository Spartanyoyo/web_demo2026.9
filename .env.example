# PostgreSQL connection. docker-compose default:
DATABASE_URL="postgresql://pointledger:pointledger_dev@localhost:5432/pointledger?schema=public"

# JWT session secret — change before any non-local use
SESSION_SECRET="pointdesk-dev-session-secret-change-me-32chars"

# Optional: simulate fulfillment outage for the flaky SKU (true/false)
FORCE_FULFILLMENT_FAIL="false"
